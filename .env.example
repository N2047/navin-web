# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Default SQLite for zero-setup local dev; replace with PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/navin_personal_db?schema=public"

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production_2026
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Frontend Cross-Origin
FRONTEND_URL=http://localhost:5173

# Optional: AI Chatbot API Key (Optional: leave empty to use built-in grounded knowledge retrieval)
GEMINI_API_KEY=
OPENAI_API_KEY=
